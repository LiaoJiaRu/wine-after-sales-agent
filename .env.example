# ═══════════════════════════════════════════════════════════
#  红酒售后理赔 Agent — 环境变量模板
#  使用方法：复制本文件为 .env，填入以下 Key 后启动
#  cp .env.example .env    (Windows: copy .env.example .env)
# ═══════════════════════════════════════════════════════════

# ── 必填项：LLM 调用 ──────────────────────────────────────────
# 没有这个 Key，Agent 无法进行路由、Judge、润色等 LLM 环节
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 选填：Langfuse 可观测性 ──────────────────────────────────
# 填了就开启 Trace 采集（答辩演示建议开启）；留空或 false 则跳过
LANGFUSE_PUBLIC_KEY=PASTE_LANGFUSE_PUBLIC_KEY_HERE
LANGFUSE_SECRET_KEY=PASTE_LANGFUSE_SECRET_KEY_HERE
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_ENABLED=true

# ── 选填：运行模式 ────────────────────────────────────────────
# true = 使用 data/mock_*.json 本地 Mock 数据（不需要真后端）
# false = 需要对接真实订单/物流/政策数据源（本项目未实现）
USE_MOCK_DATA=true

# ── 选填：存储路径 ────────────────────────────────────────────
# SQLite 工单库：留空用默认 data/wine_after_sales.db（相对路径会锚定项目根）
# Docker Compose 会覆盖为绝对路径 /app/data/wine_after_sales.db
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=1800
# SQLITE_PATH 和 TICKETS_DB_PATH 二选一；Compose 会注入 TICKETS_DB_PATH
SQLITE_PATH=data/wine_after_sales.db
# Chroma 未启用，保留占位
CHROMA_PATH=data/chroma

# ── 选填：应用行为 ────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
MAX_STEPS=20
MAX_RETRY=2
